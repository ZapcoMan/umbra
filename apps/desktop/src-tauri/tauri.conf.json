{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UMBRA",
  "version": "0.1.0",
  "identifier": "app.umbra.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UMBRA · 离线 IP 地理定位",
        "width": 1100,
        "height": 740,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../../data/ip2region_v4.xdb": "data/ip2region_v4.xdb",
      "../../../data/ip2region_v6.xdb": "data/ip2region_v6.xdb"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
